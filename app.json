{
  "expo": {
    "name": "OnTrack",
    "slug": "ontrack",
    "scheme": "ontrack",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#100d0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adamlincodesexpo.ontrack",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.adamlincodesexpo.ontrack"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#100d0a"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supabaseUrl": "https://plwzrlwwqyrcvhaehrzm.supabase.co",
      "supabasePublishableKey": "sb_publishable_MbYlI9PzGg3g0wgKr2jlcQ__L09Qx6T",
      "eas": {
        "projectId": "7e81d3d1-2c34-4245-abbf-996719c1c022"
      },
      "apiNinjasKey": "vJc83VccCSkRuSrxElKLMgk9lHZPQYXCho2HLWbg"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "OnTrack uses your photo library to set your profile photo."
        }
      ],
      "expo-notifications",
      "expo-web-browser",
      "expo-apple-authentication",
      "@bacons/apple-targets"
    ]
  }
}
